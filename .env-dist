# General
COMPOSE_PROJECT_NAME=rengine

# SSL specific configuration
AUTHORITY_NAME=reNgine-ng
AUTHORITY_PASSWORD=nSrmNkwT
COMPANY=reNgine-ng
DOMAIN_NAME=rengine-ng.example.com
COUNTRY_CODE=US
STATE=Georgia
CITY=Atlanta

# Database configurations
#  /!\ POSTGRES_USER & PG_USER must be the same user or Celery will fail to start
POSTGRES_DB=rengine
POSTGRES_USER=rengine
PGUSER=rengine
POSTGRES_PASSWORD=hE2a5@K&9nEY1fzgA6X
POSTGRES_PORT=5432
POSTGRES_HOST=db

# PgBouncer: set to 1 when the app connects via PgBouncer (default 1).
# When 1, Django uses DISABLE_SERVER_SIDE_CURSORS and CONN_HEALTH_CHECKS; migrations run against POSTGRES_DIRECT_*.
USE_PGBOUNCER=0

# Optional: set to 1 to probe PgBouncer at Django import time (default 0).
# On any probe failure (connection, import, or unexpected error), settings load still succeeds and the app
# falls back to POSTGRES_DIRECT_HOST/POSTGRES_DIRECT_PORT so startup is never blocked by the probe.
# When 0, no connection is attempted at startup.
# RENGINE_DB_PROBE_AT_STARTUP=0

# Direct PostgreSQL host/port for migrations and fallback when PgBouncer is unreachable (default: db / 5432).
POSTGRES_DIRECT_HOST=db
POSTGRES_DIRECT_PORT=5432

# When using PgBouncer, set POSTGRES_HOST=pgbouncer and POSTGRES_PORT=6432 (or your pooler host/port).
# PgBouncer service (edoburu/pgbouncer) optional tuning:
# PGBOUNCER_LISTEN_PORT=6432
# PGBOUNCER_POOL_MODE=transaction
# PGBOUNCER_MAX_CLIENT_CONN=200
# PGBOUNCER_DEFAULT_POOL_SIZE=30
# PGBOUNCER_SERVER_RESET_QUERY=DISCARD ALL

# This section is for non-interactive installations only
#

# reNgine-ng installation type (prebuilt or source)
INSTALL_TYPE=prebuilt

# reNgine-ng web interface super user
DJANGO_SUPERUSER_USERNAME=rengine
DJANGO_SUPERUSER_EMAIL=rengine@example.com
DJANGO_SUPERUSER_PASSWORD=Sm7IJG.IfHAFw9snSKv

# GPU Configuration for Ollama LLM
# Set GPU=1 to enable GPU support (default: 0 for CPU only)
# GPU_TYPE will be automatically set during installation (nvidia or rocm)
# DOCKER_RUNTIME will match GPU_TYPE when GPU support is enabled
#
GPU=0
GPU_TYPE=none
DOCKER_RUNTIME=none

# Ollama Configuration
# OLLAMA_INSTANCE=http://ollama:11434

#
# Secator Worker Configuration
# Secator workers communicate exclusively via reNgine-ng API
# This allows deploying remote workers (internal network, VPS, etc.)
#
# API Configuration (auto-generated during installation)
# For the main instance: automatically generated by generate_secator_api_key command
# For remote workers: copy the API key from the main instance's .env file
#
SECATOR_ADDONS_API_ENABLED=true
SECATOR_ADDONS_API_URL=https://proxy/api/secator
SECATOR_ADDONS_API_KEY=your-generated-api-key-here
SECATOR_ADDONS_API_HEADER_NAME=Api-Key
SECATOR_ADDONS_API_FORCE_SSL=false
SECATOR_ADDONS_API_WORKSPACE_GET_ENDPOINT=

# Note: SECATOR_ADDONS_API_KEY is automatically generated during installation/update
# For remote workers, use the public URL instead of http://web:8000

# Celery Broker Configuration (for local worker, defaults to local Redis)
# For remote workers in SSH mode: leave these empty to disable Celery
# For remote workers in RabbitMQ/Redis mode: set to your broker URL
SECATOR_CELERY_BROKER_URL=redis://redis:6379/0
SECATOR_CELERY_RESULT_BACKEND=redis://redis:6379/0
# Examples for remote workers:
#   SECATOR_CELERY_BROKER_URL=redis://your-rengine-server.com:6379/0
#   SECATOR_CELERY_RESULT_BACKEND=redis://your-rengine-server.com:6379/0
#
# Report path prefix (optional): prefix stripped from Secator paths when storing; must match
# the report root used by workers. Default: /home/secator/.secator/reports
# SECATOR_REPORTS_PREFIX=/home/secator/.secator/reports

# Secator Results Storage (optional)
# Directory where Secator stores results on the worker
# SECATOR_RESULTS=/home/secator/.secator/reports

# Runner Configuration
# Enable background sync for scan status updates
SECATOR_RUNNER_UPDATE_SYNC_BACKGROUND=1
# Maximum number of workers for background sync pool
SECATOR_RUNNER_UPDATE_SYNC_MAX_WORKERS=8

# Worker Container Configuration (for local worker mode)
# Python path inside worker container
SECATOR_WORKER_CONTAINER_PYTHON=/home/secator/.local/share/pipx/venvs/secator/bin/python
# Base path for scripts inside container
SECATOR_WORKER_CONTAINER_SCRIPT_BASE=/home/secator

# SSH Tunnel Configuration (for remote worker access)
# Local bind address for SSH tunnel
RENGINE_TUNNEL_BIND_ADDRESS=172.17.0.1
# Target host for SSH tunnel (usually the proxy container)
RENGINE_TUNNEL_TARGET_HOST=proxy
# Target port for SSH tunnel (HTTPS port on proxy)
RENGINE_TUNNEL_TARGET_PORT=443
