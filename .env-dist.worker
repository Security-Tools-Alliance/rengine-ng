# =============================================================================
# Secator Worker Configuration for Remote Deployment
# =============================================================================
# This file contains the minimum configuration needed to deploy a Secator
# worker on a remote machine (VPS, internal network, etc.)
#
# Usage:
#   1. Copy this file to .env on your remote machine
#   2. Update the values below with your reNgine-ng instance details
#   3. Run: docker-compose -f docker-compose.worker.yml up -d
#
# =============================================================================

# -----------------------------------------------------------------------------
# Redis Connection (Celery Broker & Result Backend)
# -----------------------------------------------------------------------------
# Point these to your reNgine-ng instance's Redis server
# Format: redis://[username:password@]host:port/db_number
#
# Examples:
#   - Local network: redis://192.168.1.100:6379/0
#   - VPS with authentication: redis://user:password@rengine.example.com:6379/0
#   - Secured Redis: rediss://rengine.example.com:6380/0

SECATOR_CELERY_BROKER_URL=redis://your-rengine-server:6379/0
SECATOR_CELERY_RESULT_BACKEND=redis://your-rengine-server:6379/0

# -----------------------------------------------------------------------------
# reNgine API Configuration
# -----------------------------------------------------------------------------
# Enable the API addon for Secator to send results to reNgine-ng
SECATOR_ADDONS_API_ENABLED=true

# URL of your reNgine-ng instance (used for reporting runner status and findings)
# Format: http[s]://domain[:port]/api/secator
#
# Examples:
#   - Local network: http://192.168.1.100:8000/api/secator
#   - Public instance: https://rengine.example.com/api/secator

SECATOR_ADDONS_API_URL=http://your-rengine-server:8000/api/secator

# -----------------------------------------------------------------------------
# API Key (Required)
# -----------------------------------------------------------------------------
# System API key generated during reNgine-ng installation
# You can find this in your main reNgine-ng instance's .env file
# or regenerate it with: docker exec rengine-web-1 poetry run python3 manage.py generate_secator_api_key --recreate --show-key

SECATOR_ADDONS_API_KEY=your-generated-api-key-here

# -----------------------------------------------------------------------------
# Force SSL for API Communication (Optional)
# -----------------------------------------------------------------------------
# Set to "true" to force HTTPS (recommended for production). Default is "false".
#
# Examples:
#   SECATOR_ADDONS_API_FORCE_SSL=true
#   SECATOR_ADDONS_API_FORCE_SSL=false

SECATOR_ADDONS_API_FORCE_SSL=false

# -----------------------------------------------------------------------------
# Report path prefix (optional, advanced)
# -----------------------------------------------------------------------------
# If your worker writes report paths under a different root, set it here and set
# the same SECATOR_REPORTS_PREFIX on the reNgine-ng server so stored paths match.
# Default (reNgine-ng and standard Secator worker): /home/secator/.secator/reports
# SECATOR_REPORTS_PREFIX=/home/secator/.secator/reports

# =============================================================================
# Network Configuration Notes
# =============================================================================
#
# For Remote VPS Deployment:
# ---------------------------
# - Ensure Redis port (6379) is accessible from the worker machine
# - Consider using Redis authentication (update URL with credentials)
# - Use HTTPS for RENGINE_API_URL if possible
# - Ensure firewall rules allow outbound connections
#
# For Internal Network Deployment:
# ---------------------------------
# - Worker needs access to reNgine's Redis (port 6379)
# - Worker needs HTTPS/HTTP access to reNgine API (port 443/8000)
# - No inbound connections required on the worker
# - Perfect for scanning internal infrastructure
#
# Security Recommendations:
# -------------------------
# 1. Use strong passwords for Redis authentication
# 2. Restrict Redis access by IP when possible
# 3. Use HTTPS for API communication
# 4. Keep your API key secure and rotate it periodically
# 5. Use firewall rules to limit connections
#
# =============================================================================

